{
  "@context": "http://www.w3.org/ns/csvw",
  "@id": "csv-metadata.json",
  "dc:description": "Generated by tools/csvw/generate_csvw.py from tools/csvw/*-schema.json — do not hand-edit, regenerate instead.",
  "dialect": {
    "delimiter": "\t",
    "header": true,
    "encoding": "utf-8"
  },
  "tables": [
    {
      "url": "metadata/conversations.tsv",
      "tableSchema": {
        "columns": [
          {
            "name": "code",
            "titles": "code",
            "required": true,
            "dc:description": "Conversation code — matches the <code>.vert.tsv filename."
          },
          {
            "name": "type",
            "titles": "type",
            "dc:description": "Conversation type. Not a closed set across modules — e.g. KIPasti has finer-grained subtypes like 'free-conversation:meal'."
          },
          {
            "name": "duration",
            "titles": "duration",
            "datatype": {
              "base": "time",
              "format": "HH:mm:ss"
            }
          },
          {
            "name": "participants-number",
            "titles": "participants-number",
            "datatype": "integer"
          },
          {
            "name": "participants",
            "titles": "participants",
            "separator": ";",
            "dc:description": "Semicolon-separated list of participant codes."
          },
          {
            "name": "languages",
            "titles": "languages"
          },
          {
            "name": "collection-point",
            "titles": "collection-point",
            "dc:description": "Module-specific set of site codes (e.g. BO, TO)."
          },
          {
            "name": "topic",
            "titles": "topic"
          },
          {
            "name": "moderator",
            "titles": "moderator",
            "datatype": {
              "base": "boolean",
              "format": "yes|no"
            }
          },
          {
            "name": "participants-relationship",
            "titles": "participants-relationship",
            "dc:description": "Commonly asymmetric|symmetric, not enforced as a hard constraint."
          },
          {
            "name": "year",
            "titles": "year",
            "datatype": "gYear"
          },
          {
            "name": "unknown-participant",
            "titles": "unknown-participant",
            "datatype": {
              "base": "boolean",
              "format": "yes|no"
            }
          }
        ],
        "foreignKeys": [
          {
            "columnReference": "participants",
            "reference": {
              "resource": "metadata/participants.tsv",
              "columnReference": "code"
            }
          }
        ],
        "primaryKey": "code"
      }
    },
    {
      "url": "metadata/participants.tsv",
      "tableSchema": {
        "columns": [
          {
            "name": "code",
            "titles": "code",
            "required": true,
            "dc:description": "Participant code — matches `speaker` values in vert.tsv."
          },
          {
            "name": "occupation",
            "titles": "occupation",
            "null": "_"
          },
          {
            "name": "gender",
            "titles": "gender",
            "null": "_",
            "dc:description": "Commonly F|M, not enforced as a hard constraint."
          },
          {
            "name": "conversations",
            "titles": "conversations",
            "separator": ";",
            "dc:description": "Semicolon-separated list of conversation codes this participant appears in."
          },
          {
            "name": "birth-region",
            "titles": "birth-region",
            "null": [
              "_",
              "N/A"
            ]
          },
          {
            "name": "age-range",
            "titles": "age-range",
            "null": [
              "_",
              "N/A"
            ],
            "dc:description": "5-year bucket, e.g. 21-25."
          },
          {
            "name": "study-level",
            "titles": "study-level",
            "null": [
              "_",
              "N/A"
            ]
          },
          {
            "name": "mothertongue",
            "titles": "mothertongue",
            "null": [
              "_",
              "N/A"
            ]
          },
          {
            "name": "age-of-arrival-italy",
            "titles": "age-of-arrival-italy",
            "null": [
              "_",
              "N/A"
            ]
          },
          {
            "name": "years-in-italy",
            "titles": "years-in-italy",
            "null": [
              "_",
              "N/A"
            ]
          }
        ],
        "foreignKeys": [
          {
            "columnReference": "conversations",
            "reference": {
              "resource": "metadata/conversations.tsv",
              "columnReference": "code"
            }
          }
        ],
        "primaryKey": "code"
      }
    },
    {
      "url": "tsv/SBCA001.vert.tsv",
      "tableSchema": {
        "@id": "#vert-schema-1",
        "columns": [
          {
            "name": "token_id",
            "titles": "token_id",
            "required": true,
            "dc:description": "TU_ID-TOKEN_IDX, assigned at creation. Stable and creation-order — not guaranteed monotonic within a TU after a split/add (use `id` for true order, where present)."
          },
          {
            "name": "speaker",
            "titles": "speaker",
            "required": true,
            "dc:description": "Tier ID / participant code."
          },
          {
            "name": "tu_id",
            "titles": "tu_id",
            "datatype": "integer",
            "required": true,
            "dc:description": "Transcription unit id, 0-based."
          },
          {
            "name": "unit",
            "titles": "unit",
            "datatype": "integer",
            "dc:description": "DEPRECATED — pure duplicate of tu_id, superseded by `id`. Still present in files no patch has touched yet; dropped by tools/make_patch.py as each conversation is repatched. See tools/PIPELINE.md."
          },
          {
            "name": "id",
            "titles": "id",
            "datatype": "integer",
            "dc:description": "Token's true 0-based position within its TU. Recomputed from row order on every patch — always monotonic, unlike token_id."
          },
          {
            "name": "span",
            "titles": "span",
            "required": true,
            "dc:description": "Raw Jefferson span (character slice of the original annotation)."
          },
          {
            "name": "form",
            "titles": "form",
            "required": true,
            "dc:description": "Normalized form: lowercase, no prolongations, no punctuation."
          },
          {
            "name": "lemma",
            "titles": "lemma",
            "null": "_",
            "dc:description": "Filled by the lemmatization step."
          },
          {
            "name": "upos",
            "titles": "upos",
            "null": "_",
            "dc:description": "Universal POS tag. Filled by the lemmatization step."
          },
          {
            "name": "xpos",
            "titles": "xpos",
            "null": "_"
          },
          {
            "name": "feats",
            "titles": "feats",
            "null": "_"
          },
          {
            "name": "deprel",
            "titles": "deprel",
            "null": "_"
          },
          {
            "name": "type",
            "titles": "type",
            "required": true,
            "dc:description": "Token type flag (tools/dataflags.py:tokentype). Current code emits linguistic|shortpause|nonverbalbehavior|error|warning|unknown|anonymized, but this is not enforced as a hard constraint — the code enum has drifted before (see `variation` below) and existing files may lag it."
          },
          {
            "name": "meta_label",
            "titles": "meta_label",
            "null": "_"
          },
          {
            "name": "variation",
            "titles": "variation",
            "null": "_",
            "dc:description": "Language-variation flag on the TU (tools/dataflags.py:languagevariation). Current code emits none|yes|unspecified|all, but not enforced — files serialized before a since-renamed enum member (`some` → `yes`) still contain the old name, confirmed present in KIPasti/Stra-ParlaBO/Stra-ParlaTO. Not present at all in some KIParla-collection files."
          },
          {
            "name": "jefferson_feats",
            "titles": "jefferson_feats",
            "null": "_",
            "dc:description": "Pipe-separated: Intonation=X, Interrupted=Yes, Truncated=Yes, Reduced=Yes, ProsodicLink=Yes, SpaceAfter=No, PauseAfter=Yes, Language=ISO, Orthography=Yes, Volume=X, Variation=X, Syllables=N."
          },
          {
            "name": "align",
            "titles": "align",
            "null": "_",
            "dc:description": "Begin=X / End=X / Begin=X|End=X for the first/last token of a TU."
          },
          {
            "name": "prolongations",
            "titles": "prolongations",
            "null": "_",
            "dc:description": "e.g. 3x2,7x1 (char_pos x length pairs)."
          },
          {
            "name": "pace",
            "titles": "pace",
            "null": "_",
            "dc:description": "Slow=0-5(0),... / Fast=..."
          },
          {
            "name": "guesses",
            "titles": "guesses",
            "null": "_",
            "dc:description": "0-3(0),... — genuine 'hard to understand' spans only; see PIPELINE.md for the reduction_words whitelist interaction."
          },
          {
            "name": "overlaps",
            "titles": "overlaps",
            "null": "_"
          }
        ],
        "foreignKeys": [
          {
            "columnReference": "speaker",
            "reference": {
              "resource": "metadata/participants.tsv",
              "columnReference": "code"
            }
          }
        ],
        "primaryKey": "token_id"
      }
    },
